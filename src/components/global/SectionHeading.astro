---
interface Props { index?: string; eyebrow?: string; title: string; text?: string; link?: string; linkLabel?: string; }
const { index, eyebrow, title, text, link, linkLabel } = Astro.props;
---
<div class="section-heading" data-reveal>
  <div class="section-heading-meta">
    {index && <span class="section-index">{index}</span>}
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
  </div>
  <div class="section-heading-main">
    <h2>{title}</h2>
    <div class="section-heading-side">
      {text && <p>{text}</p>}
      {link && <a class="text-link" href={link}>{linkLabel ?? 'Explore'} <span>↗</span></a>}
    </div>
  </div>
</div>
