---
import { STUDIO } from "../../../data/studio";
---

<section class="section section-studio studio-stack">
    <div class="wrap">
        <div class="studio-stack-heading">
            <span class="eyebrow">04 / THE SPACE</span><h2>
                A room for<br /><em>possibility.</em>
            </h2><p>{STUDIO.intro}</p>
        </div><div class="studio-image-pair">
            <figure>
                <img
                    src={STUDIO.images.microphone}
                    alt="Microphone at Baselard Studios"
                    loading="lazy"
                    width="1024"
                    height="1024"
                /><figcaption>RECORDING ROOM / CLOSE DETAIL</figcaption>
            </figure><figure>
                <img
                    src={STUDIO.images.controlRoom}
                    alt="Studio control room and mixing desk"
                    loading="lazy"
                    width="1024"
                    height="1024"
                /><figcaption>CONTROL ROOM / MIX & PRODUCTION</figcaption>
            </figure>
        </div><a class="text-link" href="/studio/">Explore facilities ↗</a>
    </div>
</section>
