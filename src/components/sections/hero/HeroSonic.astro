---
import { SITE, IMAGES } from '../../../config/site';
import logo from '../../../data/logo.jpg'
---
<section class="hero hero-sonic">
  <div class="hero-grid wrap">
    <div class="hero-copy" data-reveal>
      <span class="eyebrow hero-kicker">
        INDEPENDENT AUDIO-VISUAL STUDIO · EST. {SITE.founded}</span>
      <h1>Sound<br /><em>meets</em><br />vision<span class="hero-period">.</span></h1>
      <p class="hero-deck">
      </p>
      <div class="hero-actions">
        <a class="button button-light" href="/work/">Explore selected work <span>↗</span></a><a class="button button-quiet" href="/contact/">Start a conversation <span>↗</span></a>
      </div>
      <div class="hero-footnote">
        <!-- <span>UDAIPUR · INDIA</span><span>COMPOSITION · PRODUCTION · SOUND · VIDEO</span> -->
      <p class="hero-deck">
        We create the sound, shape the image and bring the whole thing together.

        </p>
      </div>
    </div>
    <div class="hero-art" data-reveal aria-label="Abstract sound sculpture with studio photograph">
      <div class="hero-art-image"><img src={IMAGES.microphone} alt="Microphone in Baselard Studios' recording space" fetchpriority="high" width="1024" height="1024" /></div>
      <div class="sonic-disc" aria-hidden="true"><div class="sonic-disc-inner">
        <img src={logo.src} alt="BS">
        <!-- <span>BS</span><small>FIELD NOTES / 01</small> -->
      </div></div>
      <svg class="hero-wave" viewBox="0 0 640 180" role="presentation" aria-hidden="true"><path d="M0 90 C42 90 42 22 82 22 S122 158 162 158 202 48 242 48 282 130 322 130 362 18 402 18 442 162 482 162 522 74 562 74 602 90 640 90"/><path d="M0 90 C42 90 42 54 82 54 S122 126 162 126 202 72 242 72 282 108 322 108 362 52 402 52 442 128 482 128 522 82 562 82 602 90 640 90"/></svg>
      <span class="art-label art-label-top">AUDIO / VISUAL<br />PRODUCTION</span><span class="art-label art-label-bottom">SIGNAL FOUND<br />24°35' N / 73°41' E</span>
    </div>
  </div>
</section>
