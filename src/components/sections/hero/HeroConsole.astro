---
import { SITE, IMAGES } from '../../../config/site';
---
<section class="hero hero-console">
  <div class="wrap console-wrap">
    <div class="console-heading"><span class="eyebrow">BASELARD STUDIOS / CONTROL ROOM 01</span><span class="eyebrow">LIVE SIGNAL · {SITE.city.toUpperCase()}</span></div>
    <div class="console-main">
      <div class="console-title"><h1>MAKE<br /><span>IT</span><br />RESONATE.</h1><p>Production with feeling.<br />Precision with perspective.</p><a class="text-link" href="/work/">Open the work archive ↗</a></div>
      <div class="console-photo"><img src={IMAGES.controlRoom} alt="Baselard Studios mixing and control room" width="1024" height="1024" /><span>CONTROL ROOM / UDAIPUR</span></div>
    </div>
    <div class="console-channels">
      {['MUSIC','FILM','SOUND','ARTIST'].map((name, i) => <a href={i === 3 ? '/story/' : '/services/'} class="console-channel"><span>CH. 0{i + 1}</span><b>{name}</b><i></i><span>↗</span></a>)}
    </div>
  </div>
</section>
