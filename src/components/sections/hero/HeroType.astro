---
import { SITE, IMAGES } from '../../../config/site';
---
<section class="hero hero-type">
  <div class="wrap hero-type-wrap">
    <div class="hero-type-top"><span class="eyebrow">AUDIO-VISUAL STUDIO / {SITE.city.toUpperCase()}</span><span class="eyebrow">EST. {SITE.founded}</span></div>
    <h1 class="type-takeover">WE MAKE<br /><span class="type-outline">SOUND</span><br />MATTER<span class="hero-period">.</span></h1>
    <div class="type-bottom">
      <div class="type-image"><img src={IMAGES.controlRoom} alt="Baselard Studios control room" loading="eager" width="1024" height="1024" /></div>
      <p>Music. Film. Sound.<br />One creative ecosystem, built around the craft.</p>
      <a class="circle-link" href="/work/" aria-label="Explore work">↗</a>
    </div>
    <div class="hero-bottom"><span>SCROLL TO EXPLORE ↓</span><span>UDAIPUR · MUMBAI · EVERYWHERE</span></div>
  </div>
</section>
