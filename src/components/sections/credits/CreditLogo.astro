    <path d="M8 12L24 8L28 24L12 28L8 12Z" fill="#FF6F00"/>
    <text x="18" y="22" font-family="'Space Grotesk', Arial, sans-serif" font-size="8" font-weight="800" fill="#FFFFFF" text-anchor="middle" letter-spacing="-0.02em">LY</text>
  </svg>
