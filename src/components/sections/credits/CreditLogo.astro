    <rect width="36" height="36" rx="8" fill="#161616" stroke="rgba(242, 240, 233, 0.14)" stroke-width="1"/>
    <rect x="6" y="10" width="24" height="16" rx="2" fill="#0A192F" stroke="#C5A059" stroke-width="1"/>
    <text x="18" y="22" font-family="'Times New Roman', serif" font-size="9" font-weight="700" fill="#F2F0E9" text-anchor="middle" letter-spacing="0.04em">IBT</text>
  </svg>
)}

