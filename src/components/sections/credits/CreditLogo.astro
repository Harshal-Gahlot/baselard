    <rect width="36" height="36" rx="8" fill="#161616" stroke="rgba(242, 240, 233, 0.14)" stroke-width="1"/>
    <circle cx="18" cy="13" r="2.5" fill="#E67E22"/>
    <path d="M12 24C12 20 15 17 18 17C21 17 24 20 24 24H12Z" stroke="#F39C12" stroke-width="1.2" fill="rgba(230, 126, 34, 0.15)"/>
