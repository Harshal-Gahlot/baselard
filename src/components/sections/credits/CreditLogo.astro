---
interface Props {
  id: string;
  size?: number;
  class?: string;
}

const { id, size = 40, class: className = '' } = Astro.props;
---

{id === 'zee-music' && (
  <svg viewBox="0 0 48 48" width={size} height={size} fill="none" xmlns="http://www.w3.org/2000/svg" class:list={['credit-logo-svg', className]} role="img" aria-label="Zee Music Company">
    <rect width="48" height="48" rx="10" fill="#141414" stroke="rgba(242, 240, 233, 0.14)" stroke-width="1"/>
    <circle cx="24" cy="24" r="17" stroke="rgba(229, 9, 20, 0.35)" stroke-width="1.2" stroke-dasharray="2 3"/>
    <circle cx="24" cy="24" r="14" fill="#1b1818"/>
    <path d="M17 18H31L20.8 29.5H31V32H17L27.2 20.5H17V18Z" fill="#F2F0E9"/>
    <path d="M28 18H31L28.8 20.5H25.8L28 18Z" fill="#E50914"/>
    <circle cx="31" cy="18" r="1.4" fill="#E50914"/>
  </svg>
)}

{id === 'global-music' && (
  <svg viewBox="0 0 48 48" width={size} height={size} fill="none" xmlns="http://www.w3.org/2000/svg" class:list={['credit-logo-svg', className]} role="img" aria-label="Global Music Junction">
    <rect width="48" height="48" rx="10" fill="#141414" stroke="rgba(242, 240, 233, 0.14)" stroke-width="1"/>
    <circle cx="24" cy="24" r="17" stroke="rgba(245, 130, 32, 0.3)" stroke-width="1"/>
    <circle cx="24" cy="24" r="13" stroke="rgba(255, 255, 255, 0.08)" stroke-width="1"/>
    <circle cx="24" cy="24" r="10" fill="#221A15" stroke="#F58220" stroke-width="1.2"/>
    <path d="M13 24C13 17.9 17.9 13 24 13" stroke="#F58220" stroke-width="1.6" stroke-linecap="round"/>
    <path d="M35 24C35 30.1 30.1 35 24 35" stroke="#F58220" stroke-width="1.6" stroke-linecap="round"/>
    <text x="24" y="27" font-family="'Space Grotesk', system-ui, sans-serif" font-size="7.5" font-weight="700" fill="#F2F0E9" text-anchor="middle" letter-spacing="-0.02em">GMJ</text>
  </svg>
)}

{id === 'balaji-telefilms' && (
  <svg viewBox="0 0 48 48" width={size} height={size} fill="none" xmlns="http://www.w3.org/2000/svg" class:list={['credit-logo-svg', className]} role="img" aria-label="Balaji Telefilms">
    <rect width="48" height="48" rx="10" fill="#141414" stroke="rgba(242, 240, 233, 0.14)" stroke-width="1"/>
    <circle cx="24" cy="24" r="17" stroke="rgba(212, 175, 55, 0.35)" stroke-width="1"/>
    <path d="M24 13L26.5 19C28.5 19 31 17 31 17C30 20.5 28.5 22 26 23C27 25 28.5 27 30 28C28 28.5 26 27.5 24.5 26.5V34H23.5V26.5C22 27.5 20 28.5 18 28C19.5 27 21 25 22 23C19.5 22 18 20.5 17 17C17 17 19.5 19 21.5 19L24 13Z" fill="#D4AF37"/>
    <circle cx="24" cy="35" r="1.2" fill="#D4AF37"/>
  </svg>
)}

{id === 'the-statesman' && (
  <svg viewBox="0 0 36 36" width={size} height={size} fill="none" xmlns="http://www.w3.org/2000/svg" class:list={['credit-logo-svg', className]} role="img" aria-label="The Statesman">
    <rect width="36" height="36" rx="8" fill="#161616" stroke="rgba(242, 240, 233, 0.14)" stroke-width="1"/>
    <circle cx="18" cy="18" r="13" stroke="rgba(242, 240, 233, 0.2)" stroke-width="0.8" stroke-dasharray="1.5 2"/>
    <text x="18" y="24" font-family="'Times New Roman', Georgia, serif" font-size="18" font-weight="700" fill="#F2F0E9" text-anchor="middle">S</text>
    <text x="18" y="32" font-family="monospace" font-size="4" fill="#999891" text-anchor="middle" letter-spacing="0.1em">1875</text>
  </svg>
)}

{id === 'ani' && (
  <svg viewBox="0 0 36 36" width={size} height={size} fill="none" xmlns="http://www.w3.org/2000/svg" class:list={['credit-logo-svg', className]} role="img" aria-label="ANI News">
    <rect width="36" height="36" rx="8" fill="#161616" stroke="rgba(242, 240, 233, 0.14)" stroke-width="1"/>
    <rect x="5" y="9" width="26" height="18" rx="4" fill="#E50914"/>
    <text x="18" y="22.5" font-family="'Space Grotesk', Arial, sans-serif" font-size="10.5" font-style="italic" font-weight="900" fill="#FFFFFF" text-anchor="middle" letter-spacing="-0.02em">ANI</text>
  </svg>
)}

{id === 'mid-day' && (
