    <circle cx="24" cy="22" r="14" stroke="#F2F0E9" stroke-width="1.5"/>
    <path d="M17 16H23C25 16 26.5 17.5 26.5 19.5C26.5 21.5 25 23 23 23H17V16Z" stroke="#F2F0E9" stroke-width="1.5"/>
    <path d="M21 21V28H27" stroke="#F2F0E9" stroke-width="1.5" stroke-linecap="round"/>
    <rect x="25" y="18" width="5" height="7" rx="2.5" fill="#F2F0E9"/>
    <path d="M23 18C23 15 32 15 32 18" stroke="#F2F0E9" stroke-width="1.2" stroke-linecap="round"/>
    <text x="24" y="42" font-family="'Space Grotesk', system-ui, sans-serif" font-size="5" font-weight="700" fill="#F2F0E9" text-anchor="middle" letter-spacing="0.08em">BASELARD</text>
