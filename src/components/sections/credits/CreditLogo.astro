    <rect width="36" height="36" rx="8" fill="#161616" stroke="rgba(242, 240, 233, 0.14)" stroke-width="1"/>
    <text x="18" y="22" font-family="'Space Grotesk', Arial, sans-serif" font-size="7.5" font-style="italic" font-weight="900" fill="#F2F0E9" text-anchor="middle" letter-spacing="-0.04em">mid·day</text>
    <circle cx="26" cy="16" r="1.5" fill="#E50914"/>
  </svg>
)}

{id === 'yahoo-news' && (
  <svg viewBox="0 0 36 36" width={size} height={size} fill="none" xmlns="http://www.w3.org/2000/svg" class:list={['credit-logo-svg', className]} role="img" aria-label="Yahoo News">
    <rect width="36" height="36" rx="8" fill="#161616" stroke="rgba(242, 240, 233, 0.14)" stroke-width="1"/>
    <rect x="6" y="8" width="24" height="20" rx="5" fill="#6001D2"/>
    <text x="15" y="23" font-family="Georgia, serif" font-size="13" font-weight="900" fill="#FFFFFF" text-anchor="middle">Y</text>
    <path d="M22 13V20M22 22.5V24" stroke="#FFFFFF" stroke-width="2.5" stroke-linecap="round"/>
  </svg>
)}

{id === 'dailyhunt' && (
  <svg viewBox="0 0 36 36" width={size} height={size} fill="none" xmlns="http://www.w3.org/2000/svg" class:list={['credit-logo-svg', className]} role="img" aria-label="Dailyhunt">
    <rect width="36" height="36" rx="8" fill="#161616" stroke="rgba(242, 240, 233, 0.14)" stroke-width="1"/>
    <path d="M18 10C18 10 13 11 13 16C13 18 15 19 18 19V10Z" fill="#00C853"/>
    <path d="M18 10C18 10 23 11 23 16C23 18 21 19 18 19V10Z" fill="#00B4D8"/>
    <path d="M18 26C18 26 13 25 13 20C13 18 15 17 18 17V26Z" fill="#FFB300"/>
    <path d="M18 26C18 26 23 25 23 20C23 18 21 17 18 17V26Z" fill="#E50914"/>
